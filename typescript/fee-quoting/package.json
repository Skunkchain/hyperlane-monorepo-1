{
  "name": "@hyperlane-xyz/fee-quoting",
  "version": "27.1.0",
  "private": true,
  "description": "Offchain fee quoting service for Hyperlane warp routes",
  "homepage": "https://www.hyperlane.xyz",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/hyperlane-xyz/hyperlane-monorepo"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf ./dist",
    "start": "node dist/scripts/run-server.js",
    "start:dev": "NODE_ENV=development LOG_FORMAT=pretty node dist/scripts/run-server.js",
    "dev": "tsc --watch",
    "lint": "eslint -c ./eslint.config.mjs",
    "format": "oxfmt --write ./src ./test",
    "test": "pnpm test:unit",
    "test:ci": "pnpm test",
    "test:unit": "mocha --config .mocharc.json './test/**/*.ts' --exit"
  },
  "dependencies": {
    "@hyperlane-xyz/registry": "catalog:",
    "@hyperlane-xyz/sdk": "workspace:*",
    "@hyperlane-xyz/utils": "workspace:*",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "pino": "catalog:",
    "pino-http": "^8.6.1",
    "prom-client": "catalog:",
    "viem": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@hyperlane-xyz/tsconfig": "workspace:^",
    "@types/chai": "catalog:",
    "@types/chai-as-promised": "catalog:",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.3",
    "@types/mocha": "catalog:",
    "@types/node": "catalog:",
    "@types/sinon": "catalog:",
    "@types/yargs": "catalog:",
    "chai": "catalog:",
    "chai-as-promised": "catalog:",
    "eslint": "catalog:",
    "mocha": "catalog:",
    "oxfmt": "catalog:",
    "pino-pretty": "catalog:",
    "sinon": "catalog:",
    "supertest": "^6.3.3",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "yargs": "catalog:"
  }
}
